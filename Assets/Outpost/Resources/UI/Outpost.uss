/* Outpost Omega HUD. Every color and size lives here. */
:root {
    --op-bg: rgba(8, 14, 22, 0.9);
    --op-bg-2: rgb(22, 32, 46);
    --op-line: rgba(80, 190, 255, 0.65);
    --op-edge: rgb(58, 78, 104);
    --op-text: rgb(226, 236, 246);
    --op-dim: rgb(150, 166, 188);
    --op-gold: rgb(255, 215, 122);
    --op-good: rgb(120, 235, 150);
    --op-bad: rgb(255, 130, 112);
    --op-cyan: rgb(130, 215, 255);
}

.op-root {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    color: var(--op-text);
    font-size: 16px;
}

.op-panel {
    background-color: var(--op-bg);
    border-top-width: 2px;
    border-top-color: var(--op-line);
    border-left-width: 1px; border-right-width: 1px; border-bottom-width: 1px;
    border-left-color: var(--op-edge); border-right-color: var(--op-edge); border-bottom-color: var(--op-edge);
}

.op-dim { color: var(--op-dim); }
.op-small { font-size: 14px; }
.op-wrap { white-space: normal; }

/* ---- resource bar */
.op-resbar {
    position: absolute; left: 0; top: 0;
    flex-direction: row; align-items: center;
    padding: 8px 18px;
    border-bottom-right-radius: 6px;
}
.op-res { margin-right: 26px; font-size: 18px; -unity-font-style: bold; }
.op-res--gold { color: var(--op-gold); }
.op-res--cyan { color: var(--op-cyan); }
.op-res--bad { color: var(--op-bad); }
.op-res--plain { -unity-font-style: normal; }

/* ---- alerts */
.op-alerts {
    position: absolute; left: 0; right: 0; top: 56px;
    align-items: center;
}
.op-alert { font-size: 20px; -unity-font-style: bold; text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9); margin-bottom: 2px; }
.op-alert--player { color: var(--op-good); }
.op-alert--alien { color: var(--op-bad); }
.op-banner { font-size: 20px; -unity-font-style: bold; color: var(--op-gold); text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9); margin-bottom: 4px; }
.op-toast {
    position: absolute; left: 0; right: 0; bottom: 270px;
    -unity-text-align: middle-center; font-size: 19px; -unity-font-style: bold;
    color: var(--op-gold); text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9);
}

/* ---- bottom row: selection panel + command card */
.op-bottom {
    position: absolute; left: 0; right: 0; bottom: 0;
    flex-direction: row; justify-content: center; align-items: flex-end;
}
.op-selection {
    width: 640px; height: 236px;
    flex-direction: row;
    padding: 10px;
    border-top-left-radius: 6px;
}
.op-portrait {
    width: 132px; height: 132px;
    background-color: var(--op-bg-2);
    border-width: 1px; border-color: var(--op-edge); border-radius: 4px;
    align-items: center; justify-content: center;
}
.op-portrait__initials { font-size: 40px; -unity-font-style: bold; color: var(--op-dim); }
.op-sel-left { width: 132px; margin-right: 12px; }
.op-sel-body { flex-grow: 1; flex-shrink: 1; }
.op-title { font-size: 22px; -unity-font-style: bold; }
.op-title--player { color: var(--op-good); }
.op-title--alien { color: var(--op-bad); }
.op-bar { height: 10px; background-color: rgba(0, 0, 0, 0.7); margin-top: 4px; border-radius: 2px; }
.op-bar__fill { height: 100%; background-color: var(--op-good); border-radius: 2px; }
.op-bar--thin { height: 5px; margin-top: 2px; }
.op-bar__fill--shield { background-color: var(--op-cyan); }
.op-bar__fill--work { background-color: var(--op-gold); }
.op-hp { font-size: 14px; margin-top: 6px; -unity-text-align: middle-center; }
.op-line { font-size: 14px; margin-top: 3px; white-space: normal; }
.op-queue { flex-direction: row; flex-wrap: wrap; margin-top: 6px; }
.op-queue__item {
    height: 34px; padding: 0 10px; margin-right: 4px; margin-top: 2px;
    background-color: var(--op-bg-2);
    border-width: 1px; border-color: var(--op-edge); border-radius: 3px;
    justify-content: center; font-size: 13px;
}
.op-queue__item:hover { border-color: var(--op-bad); }
.op-groups { flex-direction: row; flex-wrap: wrap; }
.op-group {
    width: 80px; height: 80px; margin: 3px;
    background-color: var(--op-bg-2);
    border-width: 1px; border-color: var(--op-edge); border-radius: 4px;
}
.op-group:hover { border-color: var(--op-cyan); }

/* ---- command card */
.op-card {
    width: 474px; height: 290px;
    padding: 6px;
    flex-direction: row; flex-wrap: wrap; align-content: flex-start;
    border-top-right-radius: 6px;
}
.op-cmd {
    width: 86px; height: 86px; margin: 3px;
    background-color: var(--op-bg-2);
    border-width: 1px; border-color: var(--op-edge); border-radius: 4px;
    overflow: hidden;
}
.op-cmd:hover { border-color: var(--op-cyan); background-color: rgb(34, 50, 70); }
.op-cmd:active { background-color: rgb(50, 80, 110); }
.op-cmd:disabled { opacity: 0.45; }
.op-cmd--lit { border-color: var(--op-gold); border-width: 2px; }
.op-cmd__icon { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.op-cmd__fill { position: absolute; left: 0; right: 0; bottom: 0; height: 0; background-color: rgba(0, 0, 0, 0.62); }
.op-cmd__label {
    position: absolute; left: 0; right: 0; top: 0;
    padding: 2px 3px;
    font-size: 12px; white-space: normal; -unity-text-align: upper-center;
    background-color: rgba(0, 0, 0, 0.55);
}
.op-cmd__sub {
    position: absolute; left: 0; right: 0; bottom: 0;
    padding: 1px 3px;
    font-size: 12px; -unity-text-align: lower-center; color: var(--op-gold);
    background-color: rgba(0, 0, 0, 0.55);
}
.op-cmd__key {
    position: absolute; right: 2px; bottom: 19px;
    font-size: 10px; -unity-font-style: bold; color: var(--op-cyan);
    padding: 0 3px; border-radius: 2px; background-color: rgba(0, 0, 0, 0.6);
    text-shadow: 1px 1px 1px rgba(0, 0, 0, 0.9);
}
.op-tip {
    position: absolute; right: 0; bottom: 294px; width: 474px;
    padding: 8px 10px;
    font-size: 14px; white-space: normal;
}

/* ---- leader powers (top centre) */
.op-powers {
    position: absolute; left: 700px; right: 0; top: 4px;   /* starts right of the resource bar (M2 group 4: the leader name overlapped it) */
    flex-direction: row; justify-content: center; align-items: center;
}
.op-power__leader { font-size: 14px; -unity-font-style: bold; color: var(--op-cyan); margin-right: 8px; text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9); }
.op-power {
    width: 190px; height: 44px; margin: 0 3px; padding: 0 8px;
    flex-direction: row; align-items: center;
    border-radius: 4px; overflow: hidden;
}
.op-power:hover { background-color: rgb(34, 50, 70); }
.op-power--ready { border-top-color: var(--op-cyan); }
.op-power--lit { border-top-color: var(--op-gold); border-left-color: var(--op-gold); border-right-color: var(--op-gold); border-bottom-color: var(--op-gold); }
.op-power__fill { position: absolute; left: 0; top: 0; bottom: 0; width: 0; background-color: rgba(120, 40, 40, 0.6); }
.op-power__key { width: 20px; font-size: 18px; -unity-font-style: bold; color: var(--op-cyan); }
.op-power__name { flex-grow: 1; flex-shrink: 1; font-size: 13px; -unity-font-style: bold; overflow: hidden; }
.op-power__sub { font-size: 13px; color: var(--op-gold); margin-left: 4px; }
.op-power--off .op-power__name { color: var(--op-dim); }
.op-power--off .op-power__key { color: var(--op-dim); }
.op-power-tip {
    position: absolute; top: 54px; left: 50%; width: 440px; margin-left: -220px;
    padding: 8px 10px; font-size: 14px; white-space: normal; border-radius: 4px;
}

/* ---- minimap */
.op-minimap {
    position: absolute; right: 10px; bottom: 10px;
    padding: 5px;
    border-radius: 4px;
}
.op-minimap__map { width: 300px; height: 200px; }
.op-minimap__dots { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }

/* ---- help and overlays */
.op-help {
    position: absolute; right: 10px; top: 10px; width: 470px;
    padding: 10px 12px;
    font-size: 14px; white-space: normal;
    border-radius: 4px;
}
.op-help-hint { position: absolute; right: 12px; top: 8px; font-size: 13px; color: var(--op-dim); }
.op-overlay {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
    align-items: center; justify-content: center;
}
.op-overlay__title { font-size: 64px; -unity-font-style: bold; }
.op-overlay__sub { font-size: 20px; margin-top: 8px; margin-bottom: 18px; }
.op-button {
    padding: 10px 28px;
    font-size: 18px; -unity-font-style: bold; -unity-text-align: middle-center;
    background-color: var(--op-bg-2);
    border-width: 1px; border-color: var(--op-line); border-radius: 4px;
}
.op-button:hover { background-color: rgb(40, 62, 88); }

.op-button--second { margin-top: 10px; }
.op-button--off { opacity: 0.4; }
.op-button--off:hover { background-color: var(--op-bg-2); }
.op-button__note { font-size: 13px; color: var(--op-dim); -unity-font-style: normal; }
.op-button.op-on { border-color: var(--op-gold); border-width: 2px; background-color: rgb(58, 54, 30); }

/* ---- menus: main menu, Skirmish setup, Commanders, results */
.op-screen {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgb(6, 9, 16);
    padding: 22px 36px;
}
.op-menu { align-items: center; }
.op-menu__head { align-items: center; margin-top: 80px; margin-bottom: 36px; }
.op-menu__title { font-size: 104px; -unity-font-style: bold; color: rgb(0, 229, 255); }
.op-menu__subtitle { font-size: 50px; -unity-font-style: bold; color: rgb(255, 150, 60); }
.op-menu__tag { font-size: 24px; color: var(--op-dim); margin-top: 14px; }
.op-menu__buttons { width: 400px; }
.op-menu-btn { margin-bottom: 8px; font-size: 22px; flex-direction: row; justify-content: space-between; align-items: center; }
.op-menu-btn--main { font-size: 30px; padding: 14px 28px; border-color: var(--op-cyan); border-width: 2px; }
.op-menu__foot { position: absolute; left: 18px; bottom: 12px; font-size: 18px; color: var(--op-dim); }
.op-menu__note { position: absolute; right: 18px; bottom: 12px; font-size: 16px; color: var(--op-dim); }

.op-h1 { font-size: 52px; -unity-font-style: bold; color: rgb(0, 229, 255); -unity-text-align: upper-center; margin-bottom: 8px; }
.op-h2 { font-size: 22px; -unity-font-style: bold; color: var(--op-gold); margin-top: 12px; margin-bottom: 6px; }
.op-h3 { font-size: 18px; -unity-font-style: bold; color: var(--op-gold); margin-top: 8px; margin-bottom: 4px; }
.op-h3--good { color: var(--op-good); }
.op-h3--bad { color: var(--op-bad); }
.op-row { flex-direction: row; }
.op-col { flex-direction: column; }
.op-wraprow { flex-direction: row; flex-wrap: wrap; }
.op-grow { flex-grow: 1; flex-shrink: 1; }
.op-half { width: 48%; }
.op-p { font-size: 17px; white-space: normal; color: var(--op-dim); margin-bottom: 6px; }
.op-p--bright { color: var(--op-text); font-size: 19px; }
.op-bullet { flex-direction: row; margin-bottom: 3px; }
.op-bullet__mark { width: 18px; font-size: 17px; -unity-font-style: bold; color: var(--op-cyan); }
.op-bullet__mark--good { color: var(--op-good); }
.op-bullet__mark--bad { color: var(--op-bad); }
.op-bullet__text { flex-grow: 1; flex-shrink: 1; font-size: 17px; white-space: normal; }
.op-bullet__text--dim { color: var(--op-dim); font-size: 16px; }
.op-chip { padding: 7px 14px; margin-right: 6px; margin-bottom: 6px; font-size: 17px; }
.op-list-btn { margin-bottom: 4px; padding: 7px 12px; font-size: 18px; -unity-text-align: middle-left; }
.op-footer { flex-direction: row; justify-content: space-between; align-items: flex-end; height: 72px; }
.op-big { font-size: 26px; padding: 12px 40px; }

.op-setup__cols { flex-direction: row; flex-grow: 1; }
.op-setup__left { width: 384px; margin-right: 30px; }
.op-setup__mid { width: 540px; margin-right: 30px; }
.op-setup__right { flex-grow: 1; flex-shrink: 1; }
.op-preview {
    width: 384px; height: 257px; margin-top: 10px;
    background-color: var(--op-bg-2);
    border-width: 2px; border-color: var(--op-edge);
    -unity-background-scale-mode: stretch-to-fill;
}
.op-preview__dot { position: absolute; width: 10px; height: 10px; margin-left: -5px; margin-top: -5px; border-radius: 5px; border-width: 2px; border-color: rgb(255, 215, 80); }
.op-preview__dot--player { width: 14px; height: 14px; margin-left: -7px; margin-top: -7px; border-radius: 7px; border-width: 0; background-color: rgb(0, 229, 255); }
.op-preview__dot--alien { width: 14px; height: 14px; margin-left: -7px; margin-top: -7px; border-radius: 7px; border-width: 0; background-color: rgb(255, 60, 200); }
.op-preview__dot--relay { width: 8px; height: 8px; margin-left: -4px; margin-top: -4px; border-radius: 0; border-width: 1px; border-color: rgb(255, 255, 255); }
.op-leader { padding: 10px 12px; flex-direction: row; align-items: center; margin-top: 4px; }
.op-leader__portrait { width: 84px; height: 84px; margin-right: 12px; }
.op-leader__name { font-size: 26px; -unity-font-style: bold; }
.op-leader__change { font-size: 15px; -unity-font-style: bold; color: var(--op-cyan); }
.op-loadout__col { width: 250px; margin-right: 12px; }
.op-tower { -unity-text-align: middle-left; flex-direction: row; align-items: center; padding: 3px 8px; margin-bottom: 4px; height: 40px; font-size: 16px; }
.op-tower__icon { width: 32px; height: 32px; margin-right: 8px; border-width: 0; background-color: rgba(0, 0, 0, 0); }
.op-setup__tip { position: absolute; right: 36px; bottom: 104px; width: 780px; padding: 8px 12px; white-space: normal; font-size: 16px; }

.op-roster { width: 310px; margin-right: 20px; }
.op-roster__row { flex-direction: row; justify-content: space-between; align-items: center; padding: 6px 12px; margin-bottom: 6px; height: 60px; -unity-text-align: middle-left; }
.op-roster__name { font-size: 19px; -unity-font-style: bold; }
.op-roster__role { font-size: 15px; color: var(--op-dim); }
.op-tag-active { color: var(--op-good); font-size: 14px; -unity-font-style: bold; }
.op-tag-bad { color: var(--op-bad); font-size: 14px; -unity-font-style: bold; }
.op-cpanel { flex-grow: 1; flex-shrink: 1; padding: 16px 24px; border-radius: 10px; }
.op-cpanel__head { flex-direction: row; align-items: center; }
.op-cpanel__portrait { width: 120px; height: 120px; margin-right: 18px; }
.op-cpanel__name { font-size: 40px; -unity-font-style: bold; }
.op-cpanel__role { font-size: 20px; color: var(--op-cyan); }
.op-tabs { flex-direction: row; margin-top: 12px; margin-bottom: 12px; }
.op-tab { flex-grow: 1; margin-right: 8px; padding: 8px; font-size: 17px; }
.op-diff-pip { width: 18px; height: 12px; margin-right: 4px; border-radius: 2px; background-color: rgb(50, 60, 74); }
.op-diff-pip--on { background-color: var(--op-gold); }
.op-power-box { padding: 8px 10px; margin-bottom: 8px; border-radius: 6px; background-color: var(--op-bg-2); border-width: 2px; border-color: var(--op-edge); }
.op-power-box--sig { border-color: var(--op-gold); }
.op-power-box__key { width: 30px; font-size: 26px; -unity-font-style: bold; color: var(--op-cyan); }
.op-power-box__name { font-size: 18px; -unity-font-style: bold; flex-grow: 1; }
.op-power-box__stat { font-size: 16px; color: var(--op-gold); }

.op-results { align-items: center; justify-content: center; }
.op-results__title { font-size: 96px; -unity-font-style: bold; -unity-text-align: middle-center; }
.op-results__title--win { color: rgb(0, 229, 255); }
.op-results__title--lose { color: var(--op-bad); }
.op-results__sub { font-size: 28px; margin-bottom: 18px; -unity-text-align: middle-center; }
.op-results__line { font-size: 26px; color: var(--op-dim); margin-bottom: 6px; -unity-text-align: middle-center; }
.op-results__record { font-size: 22px; color: var(--op-gold); margin-top: 10px; -unity-text-align: middle-center; }
.op-results__buttons { width: 320px; margin-top: 30px; }
.op-results__buttons > .op-button { margin-bottom: 10px; font-size: 24px; }


/* ---- settings screen and pause menu (M2 group 3) ---- */
.op-settings { padding: 22px 120px; }
.op-settings--overlay { background-color: rgba(6, 9, 16, 0.96); }
.op-settings__body { flex-grow: 1; flex-shrink: 1; min-height: 200px; }
.op-settings__scroll { flex-grow: 1; }
.op-settings__row { align-items: center; padding: 6px 10px; margin-bottom: 4px; background-color: rgba(255, 255, 255, 0.04); border-radius: 4px; }
.op-settings__label { font-size: 18px; color: rgb(225, 232, 242); }
.op-settings__value { width: 260px; font-size: 18px; -unity-text-align: middle-center; color: var(--op-gold); }
.op-settings__key { width: 170px; margin-left: 8px; padding: 6px 8px; font-size: 16px; -unity-text-align: middle-center; }
.op-settings__keyrow { padding: 3px 10px; }
.op-settings__status { min-height: 26px; margin-top: 8px; font-size: 17px; color: rgb(150, 220, 255); }
.op-settings__foot { flex-direction: row; align-items: center; margin-top: 8px; flex-shrink: 0; }
.op-settings > .op-tabs, .op-settings > .op-h1, .op-settings__status { flex-shrink: 0; }
.op-settings__top { align-items: center; justify-content: space-between; margin-bottom: 6px; }
.op-settings__foot > .op-button { width: 200px; margin-right: 12px; }
.op-settings__note { font-size: 16px; color: var(--op-gold); }
.op-pause__buttons { width: 320px; margin-top: 18px; margin-bottom: 14px; }
.op-pause__buttons > .op-button { margin-bottom: 10px; }

/* ---- help: controls overlay (F1) and first-match hints (M2 group 4) */
.op-helpov {
    position: absolute; left: 50%; top: 56px; width: 1120px; translate: -50% 0;
    padding: 10px 16px; border-radius: 4px;
    font-size: 13px; white-space: normal;
    background-color: rgba(8, 12, 22, 0.97);
}
.op-helpov__head { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 6px; }
.op-helpov__title { font-size: 22px; -unity-font-style: bold; color: var(--op-cyan); }
.op-helpov__close { padding: 4px 16px; font-size: 14px; }
.op-helpov__cols { flex-direction: row; }
.op-helpov__col { flex-grow: 1; flex-basis: 0; margin-right: 14px; }
.op-helpov__group { font-size: 12px; -unity-font-style: bold; color: var(--op-gold); margin-top: 6px; margin-bottom: 1px; }
.op-helpov__row { flex-direction: row; margin-bottom: 1px; }
.op-helpov__key { width: 140px; flex-shrink: 0; -unity-font-style: bold; color: rgb(230, 236, 245); }
.op-helpov__what { flex-grow: 1; flex-shrink: 1; white-space: normal; color: var(--op-dim); }
.op-helpov__foot { margin-top: 10px; font-size: 13px; color: var(--op-dim); }

.op-hints {
    position: absolute; left: 50%; top: 66px; width: 640px; translate: -50% 0;
    background-color: rgba(8, 12, 22, 0.92);
    padding: 8px 14px 10px 14px; border-radius: 6px;
    border-width: 2px; border-color: var(--op-cyan);
}
.op-hints__head { font-size: 12px; -unity-font-style: bold; color: var(--op-cyan); }
.op-hints__head--flash { color: var(--op-gold); }
.op-hints__text { font-size: 17px; margin-top: 2px; white-space: normal; }
.op-hints__buttons { flex-direction: row; justify-content: flex-end; margin-top: 6px; }
.op-hints__button { padding: 3px 14px; font-size: 13px; margin-left: 8px; }
